entero opcion, num1, num2, resultado
real numero, cuadrado, radio, area, pi
cadena [25] nombre

inicio
pi <- 3.1416

opcion <- 0

Mientras opcion <> 5 Haga
llamar nueva_linea
llamar nueva_linea
escriba	"========MENU PRINCIPAL========"
llamar nueva_linea
escriba	"1. sumar dos numeros"
llamar nueva_linea
escriba	"2. Calcular el cuadrado de un numero"
llamar nueva_linea
escriba	"3. Saludar por Nombre"
llamar nueva_linea
Escriba "4. Calcular el area de un circulo"
llamar nueva_linea
escriba "5. Salir"

llamar nueva_linea

escriba	"Seleccione una opcion: "
lea	opcion
llamar nueva_linea

caso opcion
1:	escriba	"Ingrese el primer numero :"
	lea num1
	escriba	"Ingrese el segundo numero :"
	lea num2
	resultado <- num1+num2
	escriba	"La suma es :"
	escriba resultado
	
2:	escriba "Ingrese Un numero :"
	lea	numero
	cuadrado <- numero * numero
	escriba " El cuadrado es :"
	escriba	cuadrado
	
3:	escriba "Cual es su Nombre : "
	lea nombre
	escriba	"Hola, Bienvenido  "
	escriba nombre
	
4: Escriba "Ingrese el radio del circulo: "
   Lea radio
   area <- pi * radio * radio
   Escriba "El area es: "
   Escriba area

	
5:	escriba "Hasta pronto...."

sino:	escriba "Opcion Invalida, Intente de nuevo..."
fin caso
Fin Mientras

fin
